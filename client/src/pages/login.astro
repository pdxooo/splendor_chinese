---
import "react-toastify/dist/ReactToastify.min.css";
import { ToastContainer } from "react-toastify";

import "../styles/loginstyle.css";
import "../styles/transitions.css";
---
<!DOCTYPE html>
<html lang="zh-CN" dir="ltr">
    <head>
        <meta charset="utf-8">
        <title>Splendor | Login</title>
        <link rel="icon" type="image/png" href="/images/SplendorFavicon.png">
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Dancing+Script&display=swap" rel="stylesheet">

    </head>

    <body>
        <ToastContainer client:load />
        <!-- Page Transition -->
        <div class="transition transition1 is-active"></div>

        <div class="login-form">
            <form id="login-form">
                <h1>璀璨宝石</h1>
                <div class="txt-field">
                    <input type="text" name="uname" required>
                    <span></span>
                    <label for="uname">用户名</label>
                </div>
                
                <div class="txt-field">          
                    <input type="password" name="psw" required>
                    <span></span>
                    <label for="psw">密码</label>
                </div>

                <div class="button-area">
                    <button class="login-button" type="submit">登录</button>
                    <button class="secondary-button show-register-button" type="button">使用邀请码注册</button>
                </div>
            </form>
            <form id="register-form" class="hidden">
                <h1>注册玩家</h1>
                <div class="txt-field">
                    <input type="text" name="reg-uname" maxlength="32" required>
                    <span></span>
                    <label for="reg-uname">用户名</label>
                </div>
                <div class="txt-field">
                    <input type="password" name="reg-psw" required>
                    <span></span>
                    <label for="reg-psw">密码（非空即可）</label>
                </div>
                <div class="txt-field">
                    <input type="password" name="invite-code" autocomplete="off" required>
                    <span></span>
                    <label for="invite-code">邀请码</label>
                </div>
                <label class="colour-field">
                    游戏颜色
                    <input type="color" name="preferred-colour" value="#2684ff">
                </label>
                <div class="button-area">
                    <button class="login-button" type="submit">注册</button>
                    <button class="secondary-button show-login-button" type="button">返回登录</button>
                </div>
            </form>
        </div>
        
        <script src="../scripts/login.js"></script>
        <script>import "../scripts/i18n-zh.js";</script>
    </body>
    <style></style>
    
</html>
