---
import "../../styles/modals.css";
import "../../styles/gameboard.css";
import ModalLayout from "../../layouts/ModalLayout.astro";
---

<ModalLayout id="buy-card-modal">
    <h1>PURCHASE</h1>
    <p>Please select the card you wish to purchase.</p>

    <div id="buy-card-board" class="buy-card-board">
        <div class="reserved-cards"></div>
        <div class="modal-board-cards">
        </div>
    </div>
    <div class="button-container">
        <button class="buy-card-back-btn" id="buy-card-back-btn">BACK</button>
        <button class="buy-card-confirm-btn" id="buy-card-confirm-btn">CONFIRM</button>
    </div>
</ModalLayout>

<ModalLayout id="dev-card-payment-modal">
    <h1>CONFIRM PURCHASE</h1>
    <p>Select the number of tokens you wish to purchase the card with.</p>
    <!-- Selected Card Here -->
    <div class="purchase-show-card board-card-dev">
        <img>
    </div>

    <div class="token-count-outer-container">

        <!-- Red Counter -->
        <board-token-counter color="red" data-payment-kind="real"></board-token-counter>

        <!-- Blue Counter -->
        <board-token-counter color="blue" data-payment-kind="real"></board-token-counter>

        <!-- Green Counter -->
        <board-token-counter color="green" data-payment-kind="real"></board-token-counter>

        <!-- White Counter -->
        <board-token-counter color="white" data-payment-kind="real"></board-token-counter>

        <!-- Brown Counter -->
        <board-token-counter color="brown" data-payment-kind="real"></board-token-counter>

        <!-- Gold Counter -->
        <board-token-counter color="gold" data-payment-kind="real"></board-token-counter>

        <div class="virtual-gold-payment">
            <span>虚拟黄金</span>
            <board-token-counter color="gold" data-payment-kind="virtual"></board-token-counter>
        </div>
    </div>

    <div class="burn-card-payment" hidden>
        <p>请选择要移除的发展卡（合计必须正好满足卡牌左下角的永久奖励费用）。</p>
        <div class="burn-card-options"></div>
    </div>

    <p class="payment-status" aria-live="polite"></p>

    <div class="button-container">
        <button class="buy-card-back-btn" id="purchase-confirm-back-btn"> BACK</button>
        <button class="buy-card-confirm-btn" id="purchase-confirm-btn">CONFIRM</button>
    </div>
</ModalLayout>
